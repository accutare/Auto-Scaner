# Copie este arquivo para .env e preencha. NUNCA compartilhe nem envie o .env por e-mail.
# No servidor, o jeito mais fácil é rodar: bash deploy/configurar.sh (ele preenche as chaves e testa).

# --- Dropbox ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# auto: usa o espaço da equipe (Dropbox Business) quando existir. off: só a pasta pessoal.
DROPBOX_TEAM_SPACE=auto

# --- IA (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_ESFORCO=medium

# --- Pastas dentro do Dropbox ---
# Clientes de hoje (só leitura: serve para a IA reconhecer os nomes)
PASTA_CLIENT_DATA=/!Accurate Complete Accounting Ltd - data files/Client Data
# Onde a estrutura nova é criada: País / Cliente / Serviço / Tipo de documento
PASTA_CLIENTES=/Clientes - Teste
# Onde o scanner salva
PASTA_ENTRADA=/Scans
PASTA_REVISAR=/Docflow/Revisar
PASTA_ERROS=/Docflow/Erros
PASTA_CONTROLE=/Docflow/Controle

# --- Regras ---
# true: só anota no Controle.xlsx para onde mandaria cada documento, sem mover nada (fase de conferência)
SIMULACAO=true
# Abaixo desta confiança (0 a 1) o documento vai para Revisar
CONFIANCA_MINIMA=0.85
# De quantos em quantos segundos olha a pasta de entrada
INTERVALO_SEGUNDOS=60
# Só processa arquivos parados há pelo menos N segundos (evita ler arquivo pela metade)
SEGUNDOS_ESTABILIZAR=30
# De quantos em quantos minutos relê a lista de clientes no Dropbox
CATALOGO_MINUTOS=15

# --- Alerta de queda (recomendado) ---
# Crie um "check" gratuito em healthchecks.io e cole aqui a URL de ping dele.
HEALTHCHECK_URL=

# --- Armazenamento local no servidor ---
DADOS_DIR=/data
