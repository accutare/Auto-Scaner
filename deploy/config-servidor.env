# Configuração do servidor que NÃO é segredo. O servidor aplica este arquivo sozinho a cada 5 minutos
# (deploy/atualizar.sh). Mudar uma linha aqui e enviar para o GitHub muda o servidor, sem Terminal.
# As chaves (Dropbox, Anthropic) ficam só no .env do servidor e nunca aqui.

# AUTOMATICO=sim  -> FASE DE TESTE: o programa NÃO fica ligado. Só processa 1 arquivo da pasta de
#                    entrada cada vez que TESTE_RODADA muda de número.
# AUTOMATICO=sim  -> ligado 24h, processa tudo o que chegar na pasta de entrada.
# LIMPEZA_RODADA  -> cada vez que muda, desfaz o teste: devolve os documentos para a pasta de entrada
#                    e só depois apaga as pastas "TESTE - ..." (vão para a lixeira do Dropbox).
#                    A limpeza roda ANTES do teste.
# LIMPEZA_ALVO    -> se preenchido, a limpeza mexe SÓ nesta pasta (precisa começar com "/TESTE - ").
# COPIAR=true     -> o teste COPIA o documento para a estrutura nova; o original fica na pasta de entrada.
AUTOMATICO=sim
LIMPEZA_RODADA=2
LIMPEZA_ALVO=/TESTE - Docflow
TESTE_RODADA=3
COPIAR=true
# Só processa arquivos que chegaram na pasta de entrada depois deste momento (UTC). Vazio = todos.
PROCESSAR_DESDE=2026-11-13T16:49:15Z

# Teste com caminho definido pela equipe (dentro de PASTA_CLIENTES). Vazio = a IA decide o caminho.
DESTINO_FIXO=AN1000/AN1000BL/11

SIMULACAO=false
PASTA_ENTRADA=/Scans
PASTA_CLIENTES=/TESTE - Clientes
PASTA_REVISAR=/TESTE - Docflow/Revisar
PASTA_ERROS=/TESTE - Docflow/Erros
PASTA_CONTROLE=/TESTE - Docflow/Controle
